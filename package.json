{
  "name": "streamapp",
  "version": "1.3.8",
  "private": true,
  "description": "App pessoal tipo Stremio: catalogo TMDB + embed providers + torrents",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "install:all": "npm ci && node node_modules/electron/install.js && npm --prefix server ci && npm --prefix web ci",
    "install:all:update": "npm install && npm --prefix server install && npm --prefix web install",
    "build": "npm --prefix web run build",
    "start": "cross-env SERVE_WEB=1 node server/src/index.js",
    "start:pwa": "npm run build && cross-env SERVE_WEB=1 node server/src/index.js",
    "app:dev": "concurrently -k -n server,web,electron -c blue,green,magenta \"npm:dev:server\" \"npm:dev:web\" \"npm:app:electron\"",
    "app:electron": "cross-env ELECTRON_DEV=1 electron .",
    "app": "npm run build && electron .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm --prefix server test && node scripts/testar-adblock.cjs && node scripts/testar-anilist-cache.mjs && node scripts/testar-comentarios-fio.mjs && node scripts/testar-comentarios-render.mjs && node scripts/testar-autoplay.mjs && node scripts/testar-estados.mjs && node scripts/testar-ganchos-deps.mjs && node scripts/testar-mencoes.mjs && node scripts/testar-notificacoes.mjs && node scripts/testar-presenca-discord.mjs && node scripts/testar-tempo.mjs && node scripts/testar-player-fonte.mjs",
    "test:adblock": "node scripts/testar-adblock.cjs",
    "test:autoplay": "node scripts/testar-autoplay.mjs",
    "test:estados": "node scripts/testar-estados.mjs",
    "test:notificacoes": "node scripts/testar-notificacoes.mjs",
    "test:tempo": "node scripts/testar-tempo.mjs",
    "test:player": "node scripts/testar-player-fonte.mjs",
    "test:deps": "node scripts/testar-ganchos-deps.mjs",
    "test:presenca": "node scripts/testar-presenca-discord.mjs",
    "test:mencoes": "node scripts/testar-mencoes.mjs",
    "test:mencoes:fumo": "node scripts/testar-mencoes-fumo.mjs",
    "app:pack": "npm run build && electron-builder --x64",
    "app:pack:zip": "npm run build && electron-builder --win zip --x64",
    "app:publish": "npm run build && electron-builder --x64 --publish always && node scripts/prune-releases.mjs",
    "test:mencoes:producao": "node scripts/testar-mencoes-producao.mjs",
    "test:anilist": "node scripts/testar-anilist-cache.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0"
  },
  "build": {
    "appId": "com.boda.meida",
    "productName": "MEIDA",
    "beforePack": "scripts/verificar-electron.cjs",
    "afterPack": "scripts/empacotar-nativos.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          ".env",
          "!node_modules",
          "!node_modules/**",
          "!data",
          "!data/**",
          "!**/*.md",
          "!**/*.markdown",
          "!**/*.map",
          "!**/*.ts",
          "!**/LICENSE*",
          "!**/license*",
          "!**/readme*",
          "!**/README*",
          "!**/{test,tests,__tests__,example,examples,.github,coverage}/**"
        ]
      },
      {
        "from": "web/dist",
        "to": "web/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "useZip": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "boda07",
        "repo": "meida",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}

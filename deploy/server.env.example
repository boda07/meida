# ============================================================================
#  MEIDA — exemplo de configuração do servidor (server/.env)
# ============================================================================
#  No servidor:
#    cp deploy/server.env.example server/.env
#  e preenche os valores. O server/.env NUNCA vai para o git (está no .gitignore).
#
#  Em produção (NODE_ENV=production) o JWT_SECRET é OBRIGATÓRIO, senão o
#  servidor recusa arrancar. Mantém sempre o MESMO valor: se mudar, todos os
#  utilizadores têm de voltar a fazer login.
# ============================================================================

# Obrigatório. Gera um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# TMDB — catálogo de filmes/séries (basta um dos dois)
# ---------------------------------------------------------------------------
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# MyAnimeList (opcional). Depois de alojares, aponta o redirect para o domínio.
# ---------------------------------------------------------------------------
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=https://SEU-SUBDOMINIO.duckdns.org/api/mal/callback

# ---------------------------------------------------------------------------
# AniList (opcional)
# ---------------------------------------------------------------------------
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=https://SEU-SUBDOMINIO.duckdns.org/api/anilist/callback

# ---------------------------------------------------------------------------
# Letterboxd (opcional; só a escrita precisa de chaves)
# ---------------------------------------------------------------------------
LETTERBOXD_API_KEY=
LETTERBOXD_API_SECRET=

# ---------------------------------------------------------------------------
# Legendas (opcional)
# ---------------------------------------------------------------------------
OPENSUBTITLES_API_KEY=

# ---------------------------------------------------------------------------
# Extratores externos (opcional)
# ---------------------------------------------------------------------------
EXTRACTOR_API_BASE=
ANIME_EXTRACTOR_BASE=

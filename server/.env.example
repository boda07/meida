# Copia este ficheiro para `.env` e preenche a tua chave do TMDB.
# Obter em: https://www.themoviedb.org/settings/api  (API Read Access Token OU API Key v3)

# Chave v3 (mais simples). Usa esta OU o token v4 abaixo.
TMDB_API_KEY=

# Alternativa: token v4 (Bearer). Se preencheres este, tem prioridade sobre a chave v3.
TMDB_ACCESS_TOKEN=

# Porta do backend
PORT=5175

# Segredo para assinar tokens de login (JWT). Poe aqui uma string aleatoria.
JWT_SECRET=muda-isto-para-uma-string-aleatoria-longa

# Legendas: chave gratis da API do OpenSubtitles (https://www.opensubtitles.com/consumers)
OPENSUBTITLES_API_KEY=

# (Opcional) Extractor externo compativel com Consumet para streams sem anuncios.
# Arranca o Consumet com Docker (ver docker-compose.yml na raiz):
#     docker compose up -d consumet
# e depois descomenta a linha abaixo:
# EXTRACTOR_API_BASE=http://localhost:3000
EXTRACTOR_API_BASE=

# (Opcional) Extrator de anime self-hosted (aniwatch-api): da player proprio ao
# anime (sub/dub + legendas soft + sync no watch party).
# Ex.: https://o-teu-host.onrender.com
ANIME_EXTRACTOR_BASE=

# (Opcional) MyAnimeList: ligar conta, importar lista e marcar episodios vistos.
# Cria uma app em https://myanimelist.net/apiconfig/create
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
# Redirect do OAuth. Se alojares o backend noutro host, muda para
# http://<esse-host>:<porta>/api/mal/callback
MAL_REDIRECT_URI=http://localhost:5175/api/mal/callback

# (Opcional) AniList: importar a tua lista e marcar episodios vistos.
# Cria uma app em https://anilist.co/api/v1/auth/developer
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
# Redirect do OAuth. Se alojares o backend noutro host, muda para
# http://<esse-host>:<porta>/api/anilist/callback
ANILIST_REDIRECT_URI=http://localhost:5175/api/anilist/callback

# (Opcional) Letterboxd: a leitura (diario + nota da comunidade) funciona sem
# chaves. A ESCRITA (marcar visto) precisa da API oficial, fechada e sujeita a
# aprovacao: pede acesso em https://letterboxd.com/api-beta/
LETTERBOXD_API_KEY=
LETTERBOXD_API_SECRET=
